rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validText(value) {
      return value is string && value.size() > 0 && value.size() <= 500;
    }

    function validCreatedAt(data) {
      return data.createdAt is timestamp;
    }

    function withinPublicRetention(data) {
      return data.createdAt is timestamp
        && data.createdAt > request.time - duration.value(180, 'd');
    }

    match /emotions/{id} {
      allow read: if withinPublicRetention(resource.data);
      allow create: if false;
      allow update, delete: if false;
    }

    match /stars/{id} {
      allow read: if withinPublicRetention(resource.data);
      allow create: if false;
      allow update, delete: if false;
    }

    match /constellations/{id} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /shards/{id} {
      allow read: if withinPublicRetention(resource.data);
      allow create: if false;
      allow update, delete: if false;
    }

    match /sand/{id} {
      // Expired messages cannot be read even while the managed TTL deletion is pending.
      allow get: if resource.data.expireAt is timestamp
        && resource.data.expireAt > request.time;
      // Firestore cannot prove a client timestamp against request.time for a
      // collection query. Keep list access bounded; the site query also filters
      // on expireAt, while managed TTL performs the physical deletion.
      allow list: if request.query.limit != null && request.query.limit <= 30;
      allow create: if false;
      allow update, delete: if false;
    }

    match /warmth/{id} {
      allow read: if withinPublicRetention(resource.data);
      allow create: if false;
      allow update, delete: if false;
    }

    // Drift letters are sent and received only through callable functions.
    // Sender and recipient hashes must never be exposed to browsers.
    match /drift_letters/{id} {
      allow read, write: if false;
    }

    match /presence/{room} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['by'])
        && request.resource.data.by is string
        && request.resource.data.by.size() <= 32;
      allow delete: if false;
    }

    match /metadata/site_stats {
      allow read: if true;
      allow write: if false;
    }

    match /metadata/room_a_stats {
      allow read: if true;
      allow write: if false;
    }

    match /metadata/public_room_stats {
      allow read: if true;
      allow write: if false;
    }

    match /metadata/silent_presence {
      allow read: if true;
      allow write: if false;
    }

    match /user_journeys/{soulKey} {
      allow get: if soulKey.matches('^(EMP-[A-Z0-9]{4,12}-[A-Z0-9]{4,12}|EMP-[A-Z0-9]{8}-[A-Z0-9]{8}-[A-Z0-9]{8}-[A-Z0-9]{8}|sj_[a-f0-9]{64})$');
      allow list: if false;
      allow create, update: if (
        soulKey.matches('^sj_[a-f0-9]{64}$')
          && request.resource.data.keys().hasOnly([
            'schemaVersion', 'cipher', 'kdf', 'iterations', 'salt', 'iv', 'ciphertext',
            'clientUpdatedAt', 'updatedAt'
          ])
          && request.resource.data.schemaVersion == 3
          && request.resource.data.cipher == 'AES-GCM-256'
          && request.resource.data.kdf == 'PBKDF2-SHA256'
          && request.resource.data.iterations == 210000
          && request.resource.data.salt is string
          && request.resource.data.salt.size() <= 64
          && request.resource.data.iv is string
          && request.resource.data.iv.size() <= 32
          && request.resource.data.ciphertext is string
          && request.resource.data.ciphertext.size() <= 750000
          && request.resource.data.clientUpdatedAt is int
          && request.resource.data.updatedAt is timestamp
      ) || (
        soulKey.matches('^(EMP-[A-Z0-9]{4,12}-[A-Z0-9]{4,12}|EMP-[A-Z0-9]{8}-[A-Z0-9]{8}-[A-Z0-9]{8}-[A-Z0-9]{8})$')
          && request.resource.data.keys().hasOnly([
            'counters', 'events', 'letters', 'visitCount', 'schemaVersion', 'clientUpdatedAt', 'updatedAt'
          ])
          && request.resource.data.counters is map
          && request.resource.data.events is list
          && request.resource.data.events.size() <= 500
          && (!('letters' in request.resource.data)
            || (request.resource.data.letters is list && request.resource.data.letters.size() <= 50))
          && request.resource.data.schemaVersion == 2
          && request.resource.data.clientUpdatedAt is int
          && request.resource.data.updatedAt is timestamp
      );
      allow delete: if false;
    }

    // Reports are accepted only through the rate-limited Cloud Function.
    // Admin SDK access is checked again by a custom admin claim in each callable.
    match /content_reports/{reportId} {
      allow read, write: if false;
    }

    match /moderation_audit/{entryId} {
      allow read, write: if false;
    }

    match /rate_limits/{bucketId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
