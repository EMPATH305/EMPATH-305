rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validText(value) {
      return value is string && value.size() > 0 && value.size() <= 500;
    }

    function validCreatedAt(data) {
      return data.createdAt is timestamp;
    }

    match /emotions/{id} {
      allow read: if true;
      allow create: if false;
      allow update, delete: if false;
    }

    match /stars/{id} {
      allow read: if true;
      allow create: if false;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['brightness', 'clicks'])
        && request.resource.data.clicks == resource.data.clicks + 1
        && request.resource.data.brightness >= resource.data.brightness
        && request.resource.data.brightness <= resource.data.brightness + 1
        && request.resource.data.brightness <= 12;
      allow delete: if false;
    }

    match /constellations/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['s1Id', 's2Id', 'createdAt'])
        && request.resource.data.s1Id is string
        && request.resource.data.s1Id.size() <= 128
        && request.resource.data.s2Id is string
        && request.resource.data.s2Id.size() <= 128
        && validCreatedAt(request.resource.data);
      allow update, delete: if false;
    }

    match /shards/{id} {
      allow read: if true;
      allow create: if false;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['healed'])
        && resource.data.healed == false
        && request.resource.data.healed == true;
      allow delete: if false;
    }

    match /sand/{id} {
      // Expired messages cannot be read even while the managed TTL deletion is pending.
      allow get: if resource.data.expireAt is timestamp
        && resource.data.expireAt > request.time;
      // Firestore cannot prove a client timestamp against request.time for a
      // collection query. Keep list access bounded; the site query also filters
      // on expireAt, while managed TTL performs the physical deletion.
      allow list: if request.query.limit != null && request.query.limit <= 30;
      allow create: if false;
      allow update, delete: if false;
    }

    match /warmth/{id} {
      allow read: if true;
      allow create: if false;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['echos'])
        && request.resource.data.echos == resource.data.echos + 1;
      allow delete: if false;
    }

    // Drift letters are sent and received only through callable functions.
    // Sender and recipient hashes must never be exposed to browsers.
    match /drift_letters/{id} {
      allow read, write: if false;
    }

    match /presence/{room} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['by'])
        && request.resource.data.by is string
        && request.resource.data.by.size() <= 32;
      allow delete: if false;
    }

    match /metadata/site_stats {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['totalVisitors'])
        && request.resource.data.totalVisitors == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalVisitors'])
        && request.resource.data.totalVisitors == resource.data.totalVisitors + 1;
      allow delete: if false;
    }

    match /metadata/room_a_stats {
      allow read: if true;
      allow write: if false;
    }

    match /metadata/silent_presence {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['bucket', 'count', 'updatedAt'])
        && request.resource.data.bucket is int
        && request.resource.data.count == 1
        && request.resource.data.updatedAt is timestamp;
      allow update: if request.resource.data.keys().hasOnly(['bucket', 'count', 'updatedAt'])
        && request.resource.data.bucket is int
        && request.resource.data.count is int
        && request.resource.data.count >= 1
        && request.resource.data.count <= 100000
        && request.resource.data.updatedAt is timestamp
        && (
          (request.resource.data.bucket == resource.data.bucket
            && request.resource.data.count == resource.data.count + 1)
          || (request.resource.data.bucket > resource.data.bucket
            && request.resource.data.count == 1)
        );
      allow delete: if false;
    }

    match /user_journeys/{soulKey} {
      allow get: if soulKey.matches('^(EMP-[A-Z0-9]{4,12}-[A-Z0-9]{4,12}|EMP-[A-Z0-9]{8}-[A-Z0-9]{8}-[A-Z0-9]{8}-[A-Z0-9]{8})$');
      allow list: if false;
      allow create, update: if soulKey.matches('^(EMP-[A-Z0-9]{4,12}-[A-Z0-9]{4,12}|EMP-[A-Z0-9]{8}-[A-Z0-9]{8}-[A-Z0-9]{8}-[A-Z0-9]{8})$')
        && request.resource.data.keys().hasOnly([
          'counters', 'events', 'letters', 'visitCount', 'schemaVersion', 'clientUpdatedAt', 'updatedAt'
        ])
        && request.resource.data.counters is map
        && request.resource.data.events is list
        && request.resource.data.events.size() <= 500
        && (!('letters' in request.resource.data)
          || (request.resource.data.letters is list && request.resource.data.letters.size() <= 50))
        && request.resource.data.schemaVersion == 2
        && request.resource.data.clientUpdatedAt is int
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    // Reports are accepted only through the rate-limited Cloud Function.
    // Admin SDK access is checked again by a custom admin claim in each callable.
    match /content_reports/{reportId} {
      allow read, write: if false;
    }

    match /moderation_audit/{entryId} {
      allow read, write: if false;
    }

    match /rate_limits/{bucketId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
